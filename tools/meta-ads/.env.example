# Copiar este archivo como ".env" (en esta misma carpeta) y completar.
# El .env real NUNCA se sube a git (está en .gitignore).

# Token del usuario del sistema "umi-ads bot" (Configuración del negocio →
# Usuarios del sistema → Generar token, permisos ads_management + business_management)
META_ADS_TOKEN=

# IDs de la cuenta (no son secretos, pero se mantienen fuera del código)
META_AD_ACCOUNT_ID=
META_PIXEL_ID=
META_CATALOG_ID=
META_PAGE_ID=
META_BUSINESS_ID=
